# Vietnamese translation of ibus-ngosen.
# Strings shared with the fcitx5 edition use its translation; misc/check-translations.py checks it.
msgid ""
msgstr ""
"Project-Id-Version: ibus-ngosen\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

#: settings/ngosen_settings/options.py
msgid "Input Method"
msgstr "Kiểu gõ"

#: settings/ngosen_settings/options.py
msgid "Switch Between English and Vietnamese"
msgstr "Phím chuyển Anh/Việt"

#: settings/ngosen_settings/options.py
msgid "Tap the keys together and let go; the top bar shows V or E. Super+Space still switches input sources."
msgstr "Nhấn cùng lúc rồi thả ra; thanh trên cùng hiện V hoặc E. Super+Space vẫn đổi nguồn nhập như cũ."

#: settings/ngosen_settings/pages.py
msgid "Other keys…"
msgstr "Phím khác…"

#: settings/ngosen_settings/pages.py
msgid "Press the new keys"
msgstr "Bấm phím mới"

#: settings/ngosen_settings/pages.py
msgid "Hold the keys together, then let go."
msgstr "Giữ các phím cùng lúc rồi thả ra."

#: settings/ngosen_settings/pages.py
msgid "Cancel"
msgstr "Huỷ"

#: settings/ngosen_settings/pages.py
msgid "Save"
msgstr "Lưu"

#: settings/ngosen_settings/keys.py
msgid "Press at least two keys together."
msgstr "Cần bấm ít nhất hai phím cùng lúc."

#: settings/ngosen_settings/keys.py
msgid "Shift with a key types a capital letter or a symbol."
msgstr "Shift kèm một phím sẽ gõ ra chữ hoa hoặc ký hiệu."

#: settings/ngosen_settings/keys.py
msgid "GNOME already uses these keys."
msgstr "GNOME đã dùng tổ hợp phím này."

#: settings/ngosen_settings/keys.py
msgid "Apps no longer get these keys: Ngó Sen takes them everywhere."
msgstr "Các app sẽ không nhận tổ hợp này nữa: Ngó Sen dùng nó ở mọi nơi."

#: settings/ngosen_settings/keys.py
msgid "Hold Ctrl, Alt, Shift or Super first, then press the other key."
msgstr "Giữ Ctrl, Alt, Shift hoặc Super trước, rồi mới bấm phím còn lại."

#: settings/ngosen_settings/keys.py
msgid "Firefox and some other apps open their menu bar when Alt is let go."
msgstr "Firefox và vài app khác sẽ mở thanh menu khi thả phím Alt."

#: src/ngosen-ibus-menu.cpp src/ngosen-ibus-engine.cpp
msgid "Vietnamese"
msgstr "Tiếng Việt"

#: src/ngosen-ibus-engine.cpp
msgid "English"
msgstr "Tiếng Anh"

#: settings/ngosen_settings/options.py
msgid "Output Charset"
msgstr "Bảng mã"

#: settings/ngosen_settings/options.py
msgid "Custom Keymap"
msgstr "Keymap tuỳ chỉnh"

#: settings/ngosen_settings/options.py
msgid "Enable Spell Check Using Dictionary"
msgstr "Kiểm tra chính tả"

#: settings/ngosen_settings/options.py
msgid "Custom Dictionary"
msgstr "Từ điển tuỳ chỉnh"

#: settings/ngosen_settings/options.py
msgid "Auto Restore Invalid Words"
msgstr "Tự khôi phục từ gõ sai"

#: settings/ngosen_settings/options.py
msgid "Key to Keep the Word as Typed"
msgstr "Phím chốt chữ"

#: settings/ngosen_settings/options.py
msgid "Allow dd To Produce đ When Auto Restore Invalid Words Is On"
msgstr "Vẫn gõ dd ra đ khi tự khôi phục"

#: settings/ngosen_settings/options.py
msgid "Use oà, uý (Instead Of òa, úy)"
msgstr "Bỏ dấu kiểu mới (oà, uý)"

#: settings/ngosen_settings/options.py
msgid "Allow Type With More Freedom"
msgstr "Gõ tự do"

#: settings/ngosen_settings/options.py
msgid "Backspace Removes the Tone Mark"
msgstr "Backspace xóa dấu thanh"

#: settings/ngosen_settings/options.py
msgid "Change the tone of a selected word"
msgstr "Cứu dấu: sửa dấu chữ đang bôi đen"

#: settings/ngosen_settings/options.py
msgid "Type w to Produce ư"
msgstr "Gõ w ra ư"

#: settings/ngosen_settings/options.py
msgid "Type [ -> ơ, ] -> ư, { -> Ơ, } -> Ư"
msgstr "Phím [ ] ra ơ ư"

#: settings/ngosen_settings/options.py
msgid "Auto capitalize after sentence-ending punctuation (. ! ? Enter)"
msgstr "Tự viết hoa đầu câu (thử nghiệm)"

#: settings/ngosen_settings/options.py
msgid "Capitalize the first letter of the text or of a line"
msgstr "Tự viết hoa chữ đầu văn bản và đầu dòng (thử nghiệm)"

#: settings/ngosen_settings/options.py
msgid "Enable Macro"
msgstr "Bật gõ tắt"

#: settings/ngosen_settings/options.py
msgid "Capitalize Macro"
msgstr "Gõ tắt chữ hoa"

#: settings/ngosen_settings/options.py
msgid "Time Format ($TIME in macro)"
msgstr "Định dạng giờ ($TIME trong gõ tắt)"

#: settings/ngosen_settings/options.py
msgid "Date Format ($DATE in macro)"
msgstr "Định dạng ngày ($DATE trong macro)"

#: settings/ngosen_settings/options.py
msgid "Keep Unicode unless an old document or app needs another one, such as TCVN3 (ABC)."
msgstr "Cứ để Unicode, trừ khi văn bản hay app cũ cần bảng mã khác như TCVN3 (ABC)."

#: settings/ngosen_settings/options.py
msgid "The keys set in the full edition, used by the Custom input method."
msgstr "Bảng phím đặt ở bản đầy đủ, dùng cho kiểu gõ Custom."

#: settings/ngosen_settings/options.py
msgid "Words that are not Vietnamese get no tone marks."
msgstr "Từ không phải tiếng Việt thì không thêm dấu."

#: settings/ngosen_settings/options.py
msgid "Check spelling against the list below. Off: the list that comes with Ngó Sen."
msgstr "Kiểm chính tả theo danh sách bên dưới. Tắt: dùng danh sách có sẵn của Ngó Sen."

#: settings/ngosen_settings/options.py
msgid "Typing windows still gives windows."
msgstr "Gõ windows vẫn ra windows."

#: settings/ngosen_settings/options.py
msgid "Tap the key alone to keep the word as shown: tunx, Ctrl → tũn, with no restore or macro. Alt also shows the menu bar in some apps."
msgstr "Bấm rồi thả riêng phím để giữ nguyên từ: tunx, Ctrl → tũn, không khôi phục hay bung macro. Alt còn hiện thanh menu ở một số app."

#: settings/ngosen_settings/options.py
msgid "dd and Space stays đ instead of going back to dd."
msgstr "Gõ dd rồi dấu cách vẫn ra đ, không bị trả về dd."

#: settings/ngosen_settings/options.py
msgid "hoà, khoẻ, thuý, tuỳ. Off: hòa, khỏe, thúy, tùy."
msgstr "hoà, khoẻ, thuý, tuỳ. Tắt: hòa, khỏe, thúy, tùy."

#: settings/ngosen_settings/options.py
msgid "Tone marks can also go at the end of the word."
msgstr "Gõ dấu ở cuối từ cũng được."

#: settings/ngosen_settings/options.py
msgid "z in Telex (0 in VNI) removes the tone mark even with this off. On a word without one, Backspace deletes as usual."
msgstr "Kể cả khi tắt mục này, phím z (Telex) hay 0 (VNI) vẫn xóa dấu thanh. Chữ không có dấu thanh thì Backspace xóa chữ như thường."

#: settings/ngosen_settings/options.py
msgid "Select chao and type f to get chào. Only with Sen on, in X11 apps; Tab or Esc puts the key back."
msgstr "Bôi đen chao rồi gõ f để ra chào. Chỉ khi bật Gõ Sen, ở app X11; Tab hay Esc trả lại phím vừa gõ."

#: settings/ngosen_settings/options.py
msgid "Non-Start: nhw → như, but w alone stays w. Everywhere: w alone gives ư too. uw always gives ư."
msgstr "Không phải đầu từ: nhw → như, còn w đứng riêng vẫn là w. Mọi nơi: w đứng riêng cũng ra ư. uw thì luôn ra ư."

#: settings/ngosen_settings/options.py
msgid "ch]a → chưa, m[f → mờ. Type a bracket twice to get it back: [[ → [."
msgstr "ch]a → chưa, m[f → mờ. Gõ ngoặc hai lần để lấy lại dấu ngoặc: [[ → [."

#: settings/ngosen_settings/options.py
msgid "ban. tooi → ban. Tôi. The same after Enter."
msgstr "ban. tooi → ban. Tôi. Sau Enter cũng vậy."

#: settings/ngosen_settings/options.py
msgid "xin → Xin in an empty field or on a new line. Not in address bars or some apps; on GNOME 47 and later, Chrome and similar apps skip an empty field."
msgstr "xin → Xin ở ô trống hoặc đầu dòng mới. Không áp dụng ở thanh địa chỉ và vài app; trên GNOME 47 trở lên, Chrome và app tương tự chưa viết hoa ở ô trống."

#: settings/ngosen_settings/options.py
msgid "Macros support dynamic placeholders: $TIME and $DATE."
msgstr "Gõ tắt có thể sử dụng giữ chỗ động: $TIME (thời gian hiện tại) và $DATE (ngày hiện tại)."

