msgstr "Không phải đầu từ"

#: settings/ngosen_settings/options.py
msgid "Everywhere"
msgstr "Mọi nơi"

#: settings/ngosen_settings/options.py
msgid "None"
msgstr "Rỗng"

#: settings/ngosen_settings/options.py
